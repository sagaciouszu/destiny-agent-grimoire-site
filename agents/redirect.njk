---
layout: false
pagination:
  data: legacyAgentRedirects
  size: 1
  alias: entry
permalink: "/agents/{{ entry.slug }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ entry.title }} ({{ entry.slug or 'old address' }}) has moved | {{ site.title }}</title>
<meta name="description" content="The old {{ entry.slug or 'agents' }} address has moved to {{ entry.target }}.">
<link rel="canonical" href="{{ site.origin }}{{ entry.target | url }}">
<meta http-equiv="refresh" content="0; url={{ entry.target | url }}">
</head>
<body>
<main>
<h1>{{ entry.title }} has moved</h1>
<p>This page is now at <a href="{{ entry.target | url }}">{{ entry.target }}</a>.</p>
</main>
</body>
</html>
