---
layout: false
pagination:
  data: agentAliases
  size: 1
  alias: entry
permalink: "/personas/{{ entry.slug }}/"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ entry.name }} (alias) | {{ site.title }}</title>
<meta name="description" content="Alias redirect for {{ entry.name }}.">
<link rel="canonical" href="{{ site.origin }}{{ ('/personas/' + entry.target + '/') | url }}">
<meta http-equiv="refresh" content="0; url={{ ('/personas/' + entry.target + '/') | url }}">
</head>
<body>
<main>
<h1>{{ entry.name }}</h1>
<p>This page has moved to <a href="{{ ('/personas/' + entry.target + '/') | url }}">the {{ entry.name }} page</a>.</p>
</main>
</body>
</html>
