<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>{{ site.title }}</a>
    <div class="header-end">
    <nav class="site-nav" aria-label="Primary">
      <details class="nav-menu"{% if section == 'grimoire' %} data-active="true"{% endif %}>
        <summary>The Grimoire</summary>
        <ul class="nav-submenu">
          <li><a href="{{ '/grimoire/' | url }}"{% if page.url == '/grimoire/' %} aria-current="page"{% endif %}>Overview</a></li>
          <li><a href="{{ '/grimoire/install/' | url }}"{% if page.url == '/grimoire/install/' %} aria-current="page"{% endif %}>Install</a></li>
          <li><a href="{{ '/grimoire/mcp/' | url }}"{% if page.url == '/grimoire/mcp/' %} aria-current="page"{% endif %}>MCP server</a></li>
        </ul>
      </details>

      <details class="nav-menu"{% if section == 'integration' %} data-active="true"{% endif %}>
        <summary>Agents &amp; Integration</summary>
        <ul class="nav-submenu">
          <li><a href="{{ '/agents/' | url }}"{% if page.url == '/agents/' %} aria-current="page"{% endif %}>Overview</a></li>
          <li><a href="{{ '/agents/install/' | url }}"{% if page.url == '/agents/install/' %} aria-current="page"{% endif %}>Install</a></li>
          <li><a href="{{ '/agents/platforms/' | url }}"{% if page.url == '/agents/platforms/' %} aria-current="page"{% endif %}>Integrations</a></li>
          <li class="nav-sep" aria-hidden="true"></li>
          <li><a href="{{ '/agents/build/' | url }}"{% if page.url == '/agents/build/' %} aria-current="page"{% endif %}>Add an Agent</a></li>
        </ul>
      </details>

      <details class="nav-menu"{% if section == 'personas' %} data-active="true"{% endif %}>
        <summary>Personas</summary>
        <ul class="nav-submenu">
          {% for agent in agents %}
          <li><a href="{{ ('/agents/' + agent.id + '/') | url }}"{% if page.url == ('/agents/' + agent.id + '/') %} aria-current="page"{% endif %}>{{ agent.name }}</a></li>
          {% endfor %}
          <li class="nav-sep" aria-hidden="true"></li>
          <li><a href="{{ '/agents/#more-personas' | url }}">More personas ({{ placeholders | length }})</a></li>
        </ul>
      </details>

      <a href="{{ '/troubleshooting/' | url }}"{% if page.url == '/troubleshooting/' %} aria-current="page"{% endif %}>Troubleshooting</a>
      <a class="nav-github" href="https://github.com/sagaciouszu/destiny-agent-grimoire" aria-label="GitHub repository" title="GitHub repository">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" title="Switch theme">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3a9 9 0 1 0 0 18h1.1a1.9 1.9 0 0 0 1.4-3.2 1.9 1.9 0 0 1 1.4-3.2h1.4A3.7 3.7 0 0 0 21 10.9 9 9 0 0 0 12 3Z"/>
        <circle cx="7.6" cy="10.2" r="1" fill="currentColor" stroke="none"/>
        <circle cx="10.1" cy="6.9" r="1" fill="currentColor" stroke="none"/>
        <circle cx="14.4" cy="7.1" r="1" fill="currentColor" stroke="none"/>
      </svg>
    </button>
    <span class="visually-hidden" data-theme-status aria-live="polite"></span>
    </div>
  </div>
</header>
