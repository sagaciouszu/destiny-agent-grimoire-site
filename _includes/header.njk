<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
    <nav class="site-nav" aria-label="Primary">
      <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>

      <details class="nav-menu"{% if section == 'grimoire' %} data-active="true"{% endif %}>
        <summary>The Grimoire</summary>
        <ul class="nav-submenu">
          <li><a href="{{ '/grimoire/' | url }}"{% if page.url == '/grimoire/' %} aria-current="page"{% endif %}>Overview</a></li>
          <li><a href="{{ '/grimoire/install/' | url }}"{% if page.url == '/grimoire/install/' %} aria-current="page"{% endif %}>Install</a></li>
          <li><a href="{{ '/grimoire/mcp/' | url }}"{% if page.url == '/grimoire/mcp/' %} aria-current="page"{% endif %}>MCP server</a></li>
        </ul>
      </details>

      <details class="nav-menu"{% if section == 'agents' %} data-active="true"{% endif %}>
        <summary>Agents &amp; Instructions</summary>
        <ul class="nav-submenu">
          <li><a href="{{ '/agents/' | url }}"{% if page.url == '/agents/' %} aria-current="page"{% endif %}>Overview</a></li>
          <li><a href="{{ '/agents/install/' | url }}"{% if page.url == '/agents/install/' %} aria-current="page"{% endif %}>Install</a></li>
          <li><a href="{{ '/agents/platforms/' | url }}"{% if page.url == '/agents/platforms/' %} aria-current="page"{% endif %}>Platforms</a></li>
        </ul>
      </details>

      <a href="{{ '/troubleshooting/' | url }}"{% if page.url == '/troubleshooting/' %} aria-current="page"{% endif %}>Troubleshooting</a>
      <a href="https://github.com/sagaciouszu/destiny-agent-grimoire">GitHub</a>
    </nav>
  </div>
</header>
