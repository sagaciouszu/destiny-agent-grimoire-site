<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}</title>
{% set pageDescription = description or lede or site.description %}
<meta name="description" content="{{ pageDescription }}">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0A0F12">
<script>
  (function () {
    try {
      var themes = ["dark", "crucible", "gambit"];
      var colors = {
        dark: "#0A0F12",
        crucible: "#0B0708",
        gambit: "#06110B"
      };
      var stored = localStorage.getItem("grimoire-theme");
      var theme = themes.indexOf(stored) !== -1 ? stored : "dark";
      document.documentElement.dataset.theme = theme;
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", colors[theme]);
    } catch (error) {}
  })();
</script>
<link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
<meta property="og:title" content="{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
{% set socialImage = ogImage or '/assets/social.png' %}
{% set socialWidth = ogImageWidth or 1280 %}
{% set socialHeight = ogImageHeight or 640 %}
{% set socialAlt = ogImageAlt or 'Destiny Agent Grimoire - a source-labelled lore archive' %}
<meta property="og:image" content="{{ site.origin }}{{ socialImage | url }}">
<meta property="og:image:width" content="{{ socialWidth }}">
<meta property="og:image:height" content="{{ socialHeight }}">
<meta property="og:image:alt" content="{{ socialAlt }}">
<meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.origin }}{{ socialImage | url }}">
<meta name="twitter:title" content="{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}">
<meta name="twitter:description" content="{{ pageDescription }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}">
<link rel="sitemap" type="application/xml" href="{{ '/sitemap.xml' | url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.title | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "description": {{ site.description | dump | safe }}
}
</script>
<link rel="stylesheet" href="{{ '/assets/site.css' | url }}?v={{ '/assets/site.css' | assetHash }}">
