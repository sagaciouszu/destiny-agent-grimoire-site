<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}</title>
{% set pageDescription = description or lede or site.description %}
<meta name="description" content="{{ pageDescription }}">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#0b0b0c">
<script>
  (function () {
    try {
      var stored = localStorage.getItem("grimoire-theme");
      var theme = stored === "light" || stored === "dark"
        ? stored
        : (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = theme;
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", theme === "light" ? "#e2d6bf" : "#0b0b0c");
    } catch (error) {}
  })();
</script>
<link rel="canonical" href="{{ site.origin }}{{ page.url | url }}">
<meta property="og:title" content="{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:image" content="{{ site.origin }}{{ '/assets/social.png' | url }}">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="Destiny Agent Grimoire — every quote keeps its source">
<meta property="og:url" content="{{ site.origin }}{{ page.url | url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.origin }}{{ '/assets/social.png' | url }}">
<meta name="twitter:title" content="{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}">
<meta name="twitter:description" content="{{ pageDescription }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}">
<link rel="sitemap" type="application/xml" href="{{ '/sitemap.xml' | url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.title | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "description": {{ site.description | dump | safe }}
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ '/assets/site.css' | url }}?v={{ '/assets/site.css' | assetHash }}">
<link href="https://fonts.cdnfonts.com/css/neue-haas-grotesk-display-pro" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
