---
layout: default
---
<div class="page">
  <article class="lore{% if setupOrder %} has-setup-order{% endif %}">
    <header class="lore-head">
      <nav class="kicker breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ '/' | url }}">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        {% set parts = category | split(" · ") %}
        {% if parts | length > 1 %}
          {% if section == 'grimoire' %}
          <a href="{{ '/grimoire/' | url }}">{{ parts[0] }}</a>
          {% elif section == 'integration' or section == 'personas' %}
          <a href="{{ '/personas/' | url }}">{{ parts[0] }}</a>
          {% elif section == 'troubleshooting' %}
          <a href="{{ '/troubleshooting/' | url }}">{{ parts[0] }}</a>
          {% else %}
          <span>{{ parts[0] }}</span>
          {% endif %}
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">{{ parts[1] }}</span>
        {% else %}
          <span aria-current="page">{{ category }}</span>
        {% endif %}
      </nav>
      <h1>{{ title }}</h1>
      {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
      {% include "setup-order.njk" %}
      {% if heroImage %}
      <figure class="hero-art">
        <img src="{{ heroImage | url }}" alt="{{ heroAlt | escape }}" width="1400" height="945">
        {% if heroCaption %}<figcaption class="hero-caption">{{ heroCaption }}</figcaption>{% endif %}
      </figure>
      {% endif %}
    </header>
    {{ content | safe }}
  </article>
</div>
