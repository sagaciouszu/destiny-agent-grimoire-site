---
layout: default
---
<div class="page">
  <article class="lore">
    <header class="lore-head">
      <p class="kicker">{{ category or "Destiny Agent Grimoire" }}</p>
      <h1>{{ title }}</h1>
      {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
    </header>
    {{ content | safe }}
  </article>
</div>
